# Copy to .env.local for local development only.
# Production secrets should be configured with Wrangler or your secrets manager.

NODE_ENV=production
LOG_LEVEL=warn
APP_URL=https://your-app.example.com

# Supabase app clients require the HTTPS project URL.
# Do not use a PostgreSQL pooler URI as SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...anon-key...
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Optional direct database URL for backup/migration scripts only.
SUPABASE_DB_URL=postgresql://postgres.[ref]:[pass]@db.[ref].supabase.co:5432/postgres

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

WABIZZ_PAYSTACK_SECRET_KEY=sk_live_...
WABIZZ_PAYSTACK_PUBLIC_KEY=pk_live_...

# Generate with a cryptographically secure random source before production use.
# ADMIN_JWT_SECRET must be at least 64 random characters. Generate with:
#   openssl rand -hex 32
CRON_SECRET=
HEALTH_CHECK_SECRET=
ADMIN_JWT_SECRET=

# Optional production integrations.
SLACK_ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=production
LOGFLARE_SOURCE_KEY=

# Used only by load tests.
ADMIN_TEST_TOKEN=
